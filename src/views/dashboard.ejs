<%- include("partials/header", { title }) %>
<div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div><p class="eyebrow">YOUR DEVELOPER WORKSPACE</p><h1>Dashboard<span class="text-accent">.</span></h1><p class="text-secondary mb-0">Your progress, backed by things you've actually built.</p></div>
  <div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-light" href="/skills/new">+ Skill</a><a class="btn btn-primary" href="/evidence/new">+ Add evidence</a></div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Skills tracked</span><div class="stat-number"><%= stats.skillCount %></div><span class="stat-foot">In your skill vault</span></div></div>
  <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Projects</span><div class="stat-number"><%= stats.projectCount %></div><span class="stat-foot">Work in progress and shipped</span></div></div>
  <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Evidence entries</span><div class="stat-number"><%= stats.evidenceCount %></div><span class="stat-foot">Features, fixes and challenges</span></div></div>
  <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Open bugs</span><div class="stat-number"><%= stats.openBugCount %></div><span class="stat-foot">Issues still to investigate</span></div></div>
</div>

<div class="row g-4">
  <div class="col-xl-7">
    <section class="panel h-100">
      <div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2 class="h5 mb-0">Latest evidence</h2></div><a class="text-link" href="/evidence">View all →</a></div>
      <% if (!recentEvidence.length) { %>
        <%- include("partials/empty", { heading: "No evidence yet", message: "Add a feature or bug fix to record what you can do." }) %>
      <% } else { %>
        <div class="list-group list-group-flush activity-list">
          <% recentEvidence.forEach(item => { %>
            <div class="list-group-item activity-row">
              <div class="activity-symbol"><%= item.type === "bug-fix" ? "⌘" : "✦" %></div>
              <div class="flex-grow-1"><div class="fw-semibold"><%= item.title %></div><div class="small text-secondary"><%= item.projectId ? item.projectId.name : "Project removed" %> · <%= formatDate(item.createdAt) %></div></div>
              <span class="status-pill <%= item.verified ? 'pill-green' : 'pill-muted' %>"><%= item.verified ? "Verified" : "Unverified" %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
  <div class="col-xl-5">
    <section class="panel h-100">
      <div class="panel-heading"><div><p class="eyebrow">PROOF OVER CLAIMS</p><h2 class="h5 mb-0">Skill status</h2></div><a class="text-link" href="/skills">Manage →</a></div>
      <% if (!skillsByStatus.length) { %>
        <%- include("partials/empty", { heading: "Your skill vault is empty", message: "Add technologies you're learning or practising." }) %>
      <% } else { %>
        <% skillsByStatus.forEach(row => { %>
          <div class="metric-row"><span><span class="metric-dot dot-<%= row._id %>"></span><%= row._id.charAt(0).toUpperCase() + row._id.slice(1) %></span><strong><%= row.count %></strong></div>
        <% }) %>
        <div class="proof-note mt-4"><span class="note-icon">✦</span><div><strong><%= stats.demonstratedSkills %> demonstrated skills</strong><p class="mb-0 small text-secondary">Mark a skill as demonstrated after adding evidence of using it.</p></div></div>
      <% } %>
      <hr class="divider">
      <div class="panel-heading mb-2"><div><p class="eyebrow">EVIDENCE BREAKDOWN</p><h2 class="h6 mb-0">What you've recorded</h2></div></div>
      <% if (!evidenceByType.length) { %><p class="text-secondary small">Evidence analytics will appear here after your first entry.</p><% } else { %>
        <% evidenceByType.forEach(row => { %><div class="metric-row"><span><%= row._id.replace("-", " ").replace(/\b\w/g, c => c.toUpperCase()) %></span><strong><%= row.count %></strong></div><% }) %>
      <% } %>
    </section>
  </div>
</div>
<%- include("partials/footer") %>
