<%- include("../partials/header", { title }) %>
<div class="page-heading mb-4"><p class="eyebrow">EVIDENCE TRACKER</p><h1><%= isEdit ? "Edit evidence" : "Add evidence" %><span class="text-accent">.</span></h1><p class="text-secondary">Describe what you actually implemented and link the relevant skills.</p></div>
<% if (!projects.length || !skills.length) { %><div class="alert alert-warning">You need at least one project and one skill before adding evidence. <a href="/projects/new">Add a project</a> · <a href="/skills/new">Add a skill</a></div><% } %>
<form class="panel form-panel" method="POST" action="<%= action %>">
  <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>
  <div class="mb-3"><label class="form-label">Title *</label><input class="form-control" name="title" required maxlength="120" value="<%= evidence.title || '' %>" placeholder="e.g. Implemented updateMany filters"></div>
  <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3" maxlength="1000" placeholder="What did you build, and how does it work?"><%= evidence.description || "" %></textarea></div>
  <div class="row g-3"><div class="col-md-6"><label class="form-label">Project *</label><select class="form-select" name="projectId" required><option value="">Choose a project</option><% projects.forEach(p => { %><option value="<%= p._id %>" <%= String(evidence.projectId || "") === String(p._id) ? "selected" : "" %>><%= p.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Type</label><select class="form-select" name="type"><% ["feature","bug-fix","tutorial","challenge","other"].forEach(v => { %><option value="<%= v %>" <%= (evidence.type || "feature") === v ? "selected" : "" %>><%= v %></option><% }) %></select></div></div>
  <div class="mt-3 mb-3"><label class="form-label">Skills demonstrated</label><div class="skill-check-grid"><% skills.forEach(s => { const ids = (evidence.skillIds || []).map(id => String(id._id || id)); %><label class="skill-check"><input type="checkbox" name="skillIds" value="<%= s._id %>" <%= ids.includes(String(s._id)) ? "checked" : "" %>><span><%= s.name %></span></label><% }) %></div></div>
  <div class="mb-3"><label class="form-label">Proof URL (optional)</label><input class="form-control" type="url" name="proofUrl" value="<%= evidence.proofUrl || '' %>" placeholder="GitHub commit, pull request, demo, etc."></div>
  <div class="form-check mb-4"><input class="form-check-input" type="checkbox" id="verified" name="verified" <%= evidence.verified ? "checked" : "" %>><label class="form-check-label" for="verified">I've reviewed this evidence and can explain how it works.</label></div>
  <div class="d-flex gap-2"><button class="btn btn-primary" <%= (!projects.length || !skills.length) ? "disabled" : "" %>><%= isEdit ? "Save changes" : "Create evidence" %></button><a href="/evidence" class="btn btn-outline-light">Cancel</a></div>
</form>
<%- include("../partials/footer") %>
