<%- include("../partials/header", { title }) %>
<div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="eyebrow">PROOF, NOT JUST CLAIMS</p><h1>Evidence Tracker<span class="text-accent">.</span></h1><p class="text-secondary mb-0">Record features, fixes and challenges you've completed.</p></div><a href="/evidence/new" class="btn btn-primary">+ Add evidence</a></div>
<section class="panel">
<% if (!evidence.length) { %><%- include("../partials/empty", { heading: "No evidence recorded", message: "Create a project and skill first, then record something you've implemented." }) %><% } else { %>
<div class="table-responsive"><table class="table app-table align-middle"><thead><tr><th>Evidence</th><th>Project</th><th>Skills</th><th>Type</th><th>Proof</th><th>Status</th><th></th></tr></thead><tbody>
<% evidence.forEach(item => { %><tr><td><div class="fw-semibold"><%= item.title %></div><div class="small text-secondary"><%= item.description || "" %></div></td><td><%= item.projectId ? item.projectId.name : "Project removed" %></td><td><div class="d-flex flex-wrap gap-1"><% item.skillIds.forEach(s => { %><span class="tag"><%= s.name %></span><% }) %></div></td><td><span class="tag"><%= item.type %></span></td><td><% if(item.proofUrl) { %><a class="text-link" href="<%= item.proofUrl %>" target="_blank" rel="noopener noreferrer">Open ↗</a><% } else { %><span class="text-secondary">—</span><% } %></td><td><span class="status-pill <%= item.verified ? 'pill-green' : 'pill-muted' %>"><%= item.verified ? "Verified" : "Unverified" %></span></td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-light" href="/evidence/<%= item._id %>/edit">Edit</a><form method="POST" action="/evidence/<%= item._id %>?_method=DELETE" data-confirm="Delete this evidence entry?"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr><% }) %>
</tbody></table></div><% } %>
</section>
<%- include("../partials/footer") %>
