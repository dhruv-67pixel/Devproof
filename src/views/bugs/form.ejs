<%- include("../partials/header", { title }) %>
<div class="page-heading mb-4"><p class="eyebrow">BUG JOURNAL</p><h1><%= isEdit ? "Edit bug log" : "Log a bug" %><span class="text-accent">.</span></h1><p class="text-secondary">Record the root cause, not just the error message.</p></div>
<form class="panel form-panel" method="POST" action="<%= action %>">
  <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>
  <div class="mb-3"><label class="form-label">Bug title *</label><input class="form-control" name="title" required maxlength="160" value="<%= bug.title || '' %>" placeholder="e.g. Update query returned zero matches"></div>
  <div class="row g-3"><div class="col-md-4"><label class="form-label">Technology</label><input class="form-control" name="technology" maxlength="80" value="<%= bug.technology || '' %>" placeholder="MongoDB"></div><div class="col-md-4"><label class="form-label">Severity</label><select class="form-select" name="severity"><% ["low","medium","high"].forEach(v => { %><option value="<%= v %>" <%= (bug.severity || "medium") === v ? "selected" : "" %>><%= v %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status"><% ["open","solved"].forEach(v => { %><option value="<%= v %>" <%= (bug.status || "open") === v ? "selected" : "" %>><%= v %></option><% }) %></select></div></div>
  <div class="mt-3 mb-3"><label class="form-label">Related project (optional)</label><select class="form-select" name="projectId"><option value="">No project</option><% projects.forEach(p => { %><option value="<%= p._id %>" <%= String(bug.projectId || "") === String(p._id) ? "selected" : "" %>><%= p.name %></option><% }) %></select></div>
  <div class="mb-3"><label class="form-label">Root cause</label><textarea class="form-control" name="rootCause" rows="2" maxlength="1000" placeholder="Why did it happen?"><%= bug.rootCause || "" %></textarea></div>
  <div class="mb-3"><label class="form-label">Fix</label><textarea class="form-control" name="fix" rows="2" maxlength="1000" placeholder="What solved it?"><%= bug.fix || "" %></textarea></div>
  <div class="mb-4"><label class="form-label">Lesson learned</label><textarea class="form-control" name="lesson" rows="2" maxlength="1000" placeholder="What will you remember next time?"><%= bug.lesson || "" %></textarea></div>
  <div class="d-flex gap-2"><button class="btn btn-primary"><%= isEdit ? "Save changes" : "Save bug log" %></button><a href="/bugs" class="btn btn-outline-light">Cancel</a></div>
</form>
<%- include("../partials/footer") %>
