<%- include("../partials/header", { title }) %>
<div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="eyebrow">KNOW WHAT YOU KNOW</p><h1>Skill Vault<span class="text-accent">.</span></h1><p class="text-secondary mb-0">Track your learning honestly and connect it to evidence.</p></div><a href="/skills/new" class="btn btn-primary">+ Add skill</a></div>
<section class="panel">
  <% if (!skills.length) { %><%- include("../partials/empty", { heading: "Your vault is empty", message: "Add your first skill to start tracking your growth." }) %><% } else { %>
  <div class="table-responsive"><table class="table app-table align-middle"><thead><tr><th>Skill</th><th>Category</th><th>Level</th><th>Status</th><th>Added</th><th class="text-end">Actions</th></tr></thead><tbody>
  <% skills.forEach(skill => { %><tr><td><div class="fw-semibold"><%= skill.name %></div><% if(skill.notes) { %><div class="small text-secondary"><%= skill.notes %></div><% } %></td><td><span class="tag"><%= skill.category %></span></td><td><%= skill.level %></td><td><span class="status-pill <%= skill.status === 'demonstrated' ? 'pill-green' : skill.status === 'practicing' ? 'pill-purple' : 'pill-muted' %>"><%= skill.status %></span></td><td class="text-secondary small"><%= formatDate(skill.createdAt) %></td><td><div class="d-flex justify-content-end gap-2"><a class="btn btn-sm btn-outline-light" href="/skills/<%= skill._id %>/edit">Edit</a><form method="POST" action="/skills/<%= skill._id %>?_method=DELETE" data-confirm="Delete this skill? Evidence entries will keep their other skills."><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr><% }) %>
  </tbody></table></div><% } %>
</section>
<%- include("../partials/footer") %>
