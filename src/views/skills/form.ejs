<%- include("../partials/header", { title }) %>
<div class="page-heading mb-4"><p class="eyebrow">SKILL VAULT</p><h1><%= isEdit ? "Edit skill" : "Add a skill" %><span class="text-accent">.</span></h1><p class="text-secondary">Keep your current level honest. You can update it as you gain evidence.</p></div>
<form class="panel form-panel" method="POST" action="<%= action %>">
  <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>
  <div class="mb-3"><label class="form-label" for="name">Skill name *</label><input class="form-control" id="name" name="name" required maxlength="80" value="<%= skill.name || '' %>" placeholder="e.g. MongoDB"></div>
  <div class="row g-3"><div class="col-md-4"><label class="form-label">Category</label><select class="form-select" name="category"><% ["Frontend","Backend","Database","Tools","Other"].forEach(v => { %><option value="<%= v %>" <%= (skill.category || "Other") === v ? "selected" : "" %>><%= v %></option><% }) %></select></div>
  <div class="col-md-4"><label class="form-label">Level</label><select class="form-select" name="level"><% ["beginner","intermediate","advanced"].forEach(v => { %><option value="<%= v %>" <%= (skill.level || "beginner") === v ? "selected" : "" %>><%= v %></option><% }) %></select></div>
  <div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status"><% ["learning","practicing","demonstrated"].forEach(v => { %><option value="<%= v %>" <%= (skill.status || "learning") === v ? "selected" : "" %>><%= v %></option><% }) %></select></div></div>
  <div class="mt-3 mb-4"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3" maxlength="500" placeholder="What are you learning or practising?"><%= skill.notes || "" %></textarea></div>
  <div class="d-flex gap-2"><button class="btn btn-primary"><%= isEdit ? "Save changes" : "Create skill" %></button><a href="/skills" class="btn btn-outline-light">Cancel</a></div>
</form>
<%- include("../partials/footer") %>
