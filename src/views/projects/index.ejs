<%- include("../partials/header", { title }) %>
<div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="eyebrow">THINGS YOU SHIP</p><h1>Project Vault<span class="text-accent">.</span></h1><p class="text-secondary mb-0">Every project is a place to demonstrate your skills.</p></div><a href="/projects/new" class="btn btn-primary">+ Add project</a></div>
<div class="row g-3">
<% if (!projects.length) { %><div class="col-12"><section class="panel"><%- include("../partials/empty", { heading: "No projects yet", message: "Add a project you're building or have completed." }) %></section></div><% } %>
<% projects.forEach(project => { %><div class="col-md-6 col-xl-4"><article class="project-card"><div class="d-flex justify-content-between align-items-start gap-2"><span class="project-icon">⌘</span><span class="status-pill <%= project.status === 'completed' ? 'pill-green' : project.status === 'in-progress' ? 'pill-purple' : 'pill-muted' %>"><%= project.status %></span></div><h2 class="h5 mt-3"><%= project.name %></h2><p class="text-secondary small project-description"><%= project.description || "No description added yet." %></p><div class="project-meta"><span>✦ <%= countMap[String(project._id)] || 0 %> evidence entries</span><span><%= formatDate(project.updatedAt) %></span></div><div class="d-flex flex-wrap gap-2 mt-3"><% if(project.githubUrl) { %><a class="btn btn-sm btn-outline-light" href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer">GitHub ↗</a><% } %><% if(project.liveUrl) { %><a class="btn btn-sm btn-outline-light" href="<%= project.liveUrl %>" target="_blank" rel="noopener noreferrer">Live demo ↗</a><% } %><a class="btn btn-sm btn-outline-light" href="/projects/<%= project._id %>/edit">Edit</a><form method="POST" action="/projects/<%= project._id %>?_method=DELETE" data-confirm="Delete this project and its evidence? Bug logs will be kept without a project link."><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></article></div><% }) %>
</div>
<%- include("../partials/footer") %>
